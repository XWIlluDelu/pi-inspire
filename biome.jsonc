{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "biome.jsonc",
      "package.json",
      "playwright.config.ts",
      "scripts/**/*.{ts,mjs}",
      "src/**/*.{ts,tsx}",
      "server/**/*.{ts,mjs}",
      "extensions/**/*.ts",
      "docs/examples/**/*.{ts,tsx}",
      "shared/**/*.ts",
      "tests/**/*.{ts,tsx,mjs}",
      "*.config.{ts,js,mjs}"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "includes": ["**", "!server/**/*.mjs"],
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "a11y": {
        "useAriaPropsSupportedByRole": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          "options": { "reportUnnecessaryDependencies": false }
        }
      },
      "nursery": {
        "noFloatingPromises": "error"
      },
      "suspicious": {
        "noDuplicateCase": "error",
        "noImportCycles": "error"
      }
    }
  },
  // Keep architecture directional: shared protocol code never learns product
  // or runtime details, the Host never depends on browser code, and browser
  // controllers stay below components so they can be tested without UI.
  "overrides": [
    {
      "includes": ["shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [{ "group": ["**/server/**", "**/src/**"] }]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": { "patterns": [{ "group": ["**/src/**"] }] }
            }
          }
        }
      }
    },
    {
      "includes": ["src/controllers/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": { "patterns": [{ "group": ["**/components/**"] }] }
            }
          }
        }
      }
    },
    {
      "includes": ["src/resource-preview.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "./components/**",
                      "./store",
                      "./store.js",
                      "./store.ts"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
