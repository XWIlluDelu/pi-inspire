{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "extensions/**/*.ts", "src/terminal-output.ts", "tests/server/**/*.ts", "tests/fixtures/workbench*.ts", "tests/fixtures/host-services.ts", "tests/fixtures/history-session.ts", "tests/fixtures/pi-workbench-provider.ts", "tests/browser/fixtures/start-host.ts", "docs/examples/*.ts", "docs/examples/task-board/*.ts", "scripts/vite-license-notices.ts", "scripts/vite-pdf-assets.ts", "scripts/vite-dev-launch.ts", "vite.config.ts", "vitest.config.ts"]
}
