#!/usr/bin/env bash
# One-command local host for INSΠRE.
# Usage:
#   ./inspire          start the configured system service or local instance
#   ./inspire restart  restart the configured system service or local instance
#   ./inspire stop     stop the configured system service or local instance
#   ./inspire status   show the configured system service or local instance
#   ./inspire mock     mock host for UI-only acceptance
#   ./inspire dev      Vite + host with hot reload
#   ./inspire build    build only
#   ./inspire connection <name> [action]
#   ./inspire --ssh-reverse [action]  shorthand for the ssh-reverse connection
#   ./inspire service install-host    install the generic host user service
#   ./inspire service enable-host     enable and start that user service
#   ./inspire service disable-host    stop and disable that user service and its maintenance timer
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done
root="$(cd "$(dirname "$script_path")" && pwd)"
cd "$root"

source_runtime="$root/server/index.ts"
release_runtime="$root/build/server/index.js"
instance_state="$root/server/instance-state.mjs"
connection_dispatcher="$root/connections/dispatch.mjs"
host_service_installer="$root/deploy/systemd/install.mjs"
host_service_controller="$root/deploy/systemd/control.mjs"
idle_maintenance_runner="$root/deploy/systemd/idle-maintenance-restart.mjs"
distribution=0
if [[ ! -f "$source_runtime" && -f "$release_runtime" ]]; then
  distribution=1
  instance_state="$root/build/server/instance-state.mjs"
fi

mode="${1:-start}"
instance_host=""
instance_port=""
state_path=""
lock_path=""
stop_request_path=""
launcher_lock_fd=""
launcher_lock_owned=0
host_service_output=""

need_node() {
  if ! command -v node >/dev/null 2>&1; then
    echo "Node.js is required (22.19+)." >&2
    exit 1
  fi
  if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || major === 22 && minor >= 19 ? 0 : 1)'; then
    echo "Node.js 22.19 or newer is required." >&2
    exit 1
  fi
}

# Portable SHA-256 of stdin; falls back across common tools.
hash_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | cut -d' ' -f1
  else
    cksum | cut -d' ' -f1
  fi
}

deps_hash() {
  hash_stdin < package-lock.json 2>/dev/null || true
}

# A fingerprint of every input that affects the built client, so a pulled
# source or config change forces a rebuild instead of running an old bundle.
# The build script uses this same Node implementation to stamp the checkout.
source_hash() {
  node "$root/scripts/source-build-hash.mjs"
}

ensure_deps() {
  if [[ "$distribution" == "1" ]]; then return 0; fi
  local want stamp="node_modules/.inspire-deps"
  want="$(deps_hash)"
  # The production launcher still builds TypeScript/Vite and starts the host
  # through tsx. NODE_ENV=production makes npm omit devDependencies by default,
  # so request the build/runtime toolchain explicitly and treat missing bins as
  # an incomplete installation even when the lockfile stamp already matches.
  if [[ ! -d node_modules || "$(cat "$stamp" 2>/dev/null || true)" != "$want" ||
        ! -x node_modules/.bin/tsc || ! -x node_modules/.bin/vite || ! -x node_modules/.bin/tsx ]]; then
    echo "Installing dependencies…"
    npm install --include=dev
    printf '%s\n' "$want" > "$stamp"
  fi
}

do_build() {
  if [[ "$distribution" == "1" ]]; then
    echo "This package already contains its production build."
    return 0
  fi
  echo "Building client…"
  # Retain build failures and warnings without printing hundreds of Unicode-range
  # font assets during an ordinary source launch.
  npm run build
}

ensure_build() {
  if [[ "$distribution" == "1" ]]; then
    if [[ ! -f "$root/dist/index.html" || ! -f "$release_runtime" || ! -f "$instance_state" ]]; then
      echo "The installed INSΠRE package is incomplete." >&2
      return 1
    fi
    return 0
  fi
  if [[ ! -f dist/index.html || "$(cat .inspire-build 2>/dev/null || true)" != "$(source_hash)" ]]; then
    do_build
  fi
}

open_url() {
  local url="$1"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  elif command -v gio >/dev/null 2>&1; then
    gio open "$url" >/dev/null 2>&1 || true
  fi
}

# A service's ExecStart is this launcher too. Only that exact process skips
# delegation. Explicit instance inputs preserve isolated tests and alternate
# local instances.
is_host_service_exec() {
  [[ -n "${SYSTEMD_EXEC_PID:-}" && "${SYSTEMD_EXEC_PID}" == "$$" ]]
}

should_manage_host_service() {
  is_host_service_exec && return 1
  [[ ! -v INSPIRE_STATE_PATH ]] || return 1
  [[ ! -v INSPIRE_HOST ]] || return 1
  [[ ! -v INSPIRE_PORT ]] || return 1
  [[ ! -v INSPIRE_TOKEN ]] || return 1
  [[ ! -v INSPIRE_MOCK ]] || return 1
  return 0
}

manage_host_service() {
  local action="$1" quiet="${2:-0}" code
  host_service_output=""
  should_manage_host_service || return 3
  if host_service_output="$(node "$host_service_controller" --root "$root" "$action")"; then
    code=0
  else
    code=$?
  fi
  if [[ "$quiet" != "1" && -n "$host_service_output" ]]; then
    printf '%s\n' "$host_service_output"
  fi
  return "$code"
}

init_instance() {
  instance_host="${INSPIRE_HOST:-127.0.0.1}"
  instance_port="${INSPIRE_PORT:-4587}"
  if [[ -n "${INSPIRE_STATE_PATH:-}" ]]; then
    state_path="$INSPIRE_STATE_PATH"
    mkdir -p "$(dirname "$state_path")"
  else
    local runtime_dir key
    runtime_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}/inspire-$UID}/inspire"
    install -d -m 700 "$runtime_dir"
    key="$(printf '%s\0%s\0%s' "$root" "$instance_host" "$instance_port" | hash_stdin)"
    state_path="$runtime_dir/${key}.json"
  fi
  lock_path="${state_path}.lock"
  stop_request_path="${state_path}.stop-request"
  export INSPIRE_STATE_PATH="$state_path"
  export INSPIRE_STOP_REQUEST_PATH="$stop_request_path"
}

inspect_instance() {
  local mock="$1"
  node "$instance_state" inspect \
    "$state_path" "$root" "$instance_host" "$instance_port" "$mock"
}

wait_for_host_ready() {
  local code
  need_node
  init_instance
  while true; do
    if inspect_instance 0 >/dev/null 2>&1; then
      return 0
    else
      code=$?
    fi
    if [[ "$code" == "5" ]]; then
      echo "The system service started in the wrong INSΠRE runtime mode." >&2
      return 1
    fi
    if [[ -n "${MAINPID:-}" ]] && ! kill -0 "$MAINPID" 2>/dev/null; then
      echo "The INSΠRE Host process exited before becoming ready." >&2
      return 1
    fi
    sleep 0.1
  done
}

show_existing() {
  local mock="$1" url code
  if url="$(inspect_instance "$mock")"; then
    echo "INSΠRE is already running."
    echo "$url"
    if [[ "${INSPIRE_OPEN:-1}" == "1" ]]; then open_url "$url"; fi
    return 0
  else
    code=$?
  fi
  case "$code" in
    3) return 3 ;;
    4)
      echo "A managed INSΠRE process exists but is not responding." >&2
      echo "Use './inspire restart' for an explicit graceful replacement." >&2
      return 1
      ;;
    5)
      echo "This port is occupied by INSΠRE in a different runtime mode." >&2
      echo "Use './inspire stop' before switching between real and mock modes." >&2
      return 1
      ;;
    *)
      echo "Unable to inspect the existing INSΠRE instance." >&2
      return 1
      ;;
  esac
}

open_instance_lock() {
  if ! command -v flock >/dev/null 2>&1; then
    echo "flock is required for safe single-instance startup." >&2
    return 1
  fi
  if [[ -n "$launcher_lock_fd" ]]; then return 0; fi
  local old_umask fd
  old_umask="$(umask)"
  umask 077
  exec {fd}>>"$lock_path"
  umask "$old_umask"
  launcher_lock_fd="$fd"
}

release_instance_lock() {
  if [[ -z "$launcher_lock_fd" ]]; then return 0; fi
  local fd="$launcher_lock_fd"
  if [[ "$launcher_lock_owned" == "1" ]]; then
    flock -u "$fd" || true
  fi
  exec {launcher_lock_fd}>&-
  launcher_lock_fd=""
  launcher_lock_owned=0
}

try_acquire_instance_lock() {
  open_instance_lock || return 1
  if [[ "$launcher_lock_owned" == "1" ]]; then return 0; fi
  if flock -n "$launcher_lock_fd"; then
    launcher_lock_owned=1
    return 0
  fi
  return 1
}

acquire_instance_lock() {
  local mock="$1" detect_existing="${2:-1}" url
  try_acquire_instance_lock && return 0
  for _ in {1..75}; do
    if try_acquire_instance_lock; then return 0; fi
    if [[ "$detect_existing" == "1" ]] && url="$(inspect_instance "$mock" 2>/dev/null)"; then
      echo "INSΠRE is already running."
      echo "$url"
      if [[ "${INSPIRE_OPEN:-1}" == "1" ]]; then open_url "$url"; fi
      release_instance_lock
      return 2
    fi
    sleep 0.2
  done
  echo "Another INSΠRE launcher is still starting or stopping this instance." >&2
  release_instance_lock
  return 1
}

require_free_port() {
  if ! node "$instance_state" port \
    "$state_path" "$root" "$instance_host" "$instance_port"; then
    echo "Port ${instance_host}:${instance_port} is already in use, but no healthy managed INSΠRE state was found." >&2
    echo "Refusing to stop an unknown process. Inspect it with:" >&2
    echo "  ss -ltnp 'sport = :${instance_port}'" >&2
    return 1
  fi
}

run_host() {
  local mock="${1:-0}" lock_result service_result
  need_node
  if [[ "$mock" == "0" ]]; then
    if manage_host_service start; then return 0; else service_result=$?; fi
    [[ "$service_result" == "3" ]] || return "$service_result"
  fi
  export NODE_ENV=production
  export INSPIRE_OPEN="${INSPIRE_OPEN:-1}"
  init_instance

  if show_existing "$mock"; then
    release_instance_lock
    return 0
  else
    [[ "$?" == "3" ]] || { release_instance_lock; return 1; }
  fi

  if acquire_instance_lock "$mock"; then
    :
  else
    lock_result=$?
    [[ "$lock_result" == "2" ]] && return 0
    return 1
  fi

  # Recheck after taking the startup lock: another launcher may have completed
  # between the first inspection and lock acquisition.
  if show_existing "$mock"; then
    release_instance_lock
    return 0
  else
    [[ "$?" == "3" ]] || { release_instance_lock; return 1; }
  fi
  if ! require_free_port; then
    release_instance_lock
    return 1
  fi
  if ! ensure_deps; then
    release_instance_lock
    return 1
  fi
  if ! ensure_build; then
    release_instance_lock
    return 1
  fi
  if [[ -e "$stop_request_path" ]]; then
    rm -f "$stop_request_path"
    echo "INSΠRE startup was cancelled by a concurrent stop request."
    release_instance_lock
    return 0
  fi

  if [[ "$mock" == "1" ]]; then
    export INSPIRE_MOCK=1
  else
    unset INSPIRE_MOCK || true
  fi
  export INSPIRE_INSTALLATION_ROOT="$root"
  if [[ "$distribution" == "1" ]]; then
    exec node "$release_runtime"
  fi
  exec npx --no-install tsx server/index.ts
}

finish_stop() {
  local code="$1" retain_lock="${2:-0}"
  # A standalone stop must not leave an unneeded lifetime lock open. A
  # restart keeps a successfully acquired lock so its start uses the same
  # ownership scope; failures release it before returning as well.
  if [[ "$retain_lock" != "1" || "$code" != "0" ]]; then
    release_instance_lock
  fi
  return "$code"
}

stop_host() {
  local retain_lock="${1:-0}" code service_result
  need_node
  if manage_host_service stop; then return 0; else service_result=$?; fi
  [[ "$service_result" == "3" ]] || return "$service_result"
  if ! command -v flock >/dev/null 2>&1; then
    echo "flock is required for safe instance shutdown." >&2
    return 1
  fi
  init_instance
  if node "$instance_state" stop \
    "$state_path" "$root" "$instance_host" "$instance_port"; then
    if [[ "$retain_lock" == "1" ]] && ! acquire_instance_lock 0 0; then
      echo "Unable to retain the INSΠRE launcher lock for restart." >&2
      return 1
    fi
    finish_stop 0 "$retain_lock"
    return $?
  else
    code=$?
  fi
  case "$code" in
    4)
      echo "The managed process could not be stopped." >&2
      finish_stop 1 "$retain_lock"
      return $?
      ;;
    6)
      echo "Timed out waiting for INSΠRE to stop; it was not force-killed." >&2
      finish_stop 1 "$retain_lock"
      return $?
      ;;
    3) ;;
    *)
      echo "Unable to stop the managed INSΠRE instance." >&2
      finish_stop 1 "$retain_lock"
      return $?
      ;;
  esac

  # No state may simply mean a launcher is still installing or building. If
  # its lifetime lock is held, publish a private cancellation request and
  # wait until that launcher either exits or publishes a stoppable process.
  if try_acquire_instance_lock; then
    rm -f "$stop_request_path"
    echo "No managed INSΠRE instance is running."
    finish_stop 0 "$retain_lock"
    return $?
  fi
  printf '%s\n' "stop requested at $(date -u +%FT%TZ)" > "$stop_request_path"
  for _ in {1..300}; do
    if node "$instance_state" stop \
      "$state_path" "$root" "$instance_host" "$instance_port" >/dev/null 2>&1; then
      rm -f "$stop_request_path"
      echo "Stopped the INSΠRE instance that was starting."
      if [[ "$retain_lock" == "1" ]] && ! acquire_instance_lock 0 0; then
        echo "Unable to retain the INSΠRE launcher lock for restart." >&2
        finish_stop 1 "$retain_lock"
        return $?
      fi
      finish_stop 0 "$retain_lock"
      return $?
    else
      code=$?
    fi
    if [[ "$code" != "3" ]]; then
      rm -f "$stop_request_path"
      echo "Unable to stop the INSΠRE instance that was starting." >&2
      finish_stop 1 "$retain_lock"
      return $?
    fi
    if try_acquire_instance_lock; then
      rm -f "$stop_request_path"
      echo "Cancelled the pending INSΠRE startup."
      finish_stop 0 "$retain_lock"
      return $?
    fi
    sleep 0.1
  done
  rm -f "$stop_request_path"
  echo "Timed out waiting for the pending INSΠRE startup; it was not force-killed." >&2
  finish_stop 1 "$retain_lock"
  return $?
}

restart_host() {
  local service_result
  need_node
  if manage_host_service restart; then return 0; else service_result=$?; fi
  [[ "$service_result" == "3" ]] || return "$service_result"
  stop_host 1
  run_host 0
}

idle_maintenance_restart() {
  need_node
  init_instance
  # The runner reads the private state token and makes the authenticated lease
  # request. It only invokes systemd after the host atomically fences new work.
  exec node "$idle_maintenance_runner" \
    --root "$root" \
    --state "$state_path" \
    --controller "$host_service_controller"
}

status_host() {
  local service_result url
  need_node
  if manage_host_service status 1; then
    # A running service must still prove that its authenticated Host responds;
    # an alive but wedged process is not a usable INSΠRE instance.
    init_instance
    if url="$(inspect_instance 0)"; then
      printf '%s\n' "$host_service_output"
      echo "$url"
      return 0
    fi
    echo "INSΠRE system service is active, but its Host is not reachable." >&2
    return 1
  else
    service_result=$?
  fi
  case "$service_result" in
    3) ;;
    5)
      [[ -z "$host_service_output" ]] || printf '%s\n' "$host_service_output"
      return 1
      ;;
    *) return "$service_result" ;;
  esac
  init_instance
  local url code
  if url="$(inspect_instance 0)"; then
    echo "INSΠRE is running."
    echo "$url"
    return 0
  else
    code=$?
  fi
  if [[ "$code" == "5" ]]; then
    if url="$(inspect_instance 1)"; then
      echo "INSΠRE mock is running."
      echo "$url"
      return 0
    else
      code=$?
    fi
  fi
  if [[ "$code" == "4" ]]; then
    echo "A managed INSΠRE process exists but is not responding." >&2
  else
    echo "INSΠRE is not running."
  fi
  return 1
}

case "$mode" in
  wait-ready)
    wait_for_host_ready
    ;;
  start | host | "")
    run_host 0
    ;;
  restart)
    restart_host
    ;;
  stop)
    stop_host
    ;;
  status)
    status_host
    ;;
  maintenance-restart)
    idle_maintenance_restart
    ;;
  mock)
    run_host 1
    ;;
  dev)
    need_node
    if [[ "$distribution" == "1" ]]; then
      echo "Development mode requires a source checkout." >&2
      exit 1
    fi
    ensure_deps
    export INSPIRE_TOKEN="${INSPIRE_TOKEN:-inspire-dev-token}"
    echo "Dev host token: $INSPIRE_TOKEN"
    echo "Open http://127.0.0.1:5173/?token=$INSPIRE_TOKEN after Vite starts."
    open_url "http://127.0.0.1:5173/?token=$INSPIRE_TOKEN"
    exec npm run dev
    ;;
  build)
    need_node
    ensure_deps
    do_build
    ;;
  connection)
    shift
    need_node
    exec node "$connection_dispatcher" --root "$root" "$@"
    ;;
  --ssh-reverse)
    shift
    need_node
    exec node "$connection_dispatcher" --root "$root" ssh-reverse "$@"
    ;;
  service)
    shift
    need_node
    case "${1:-}" in
      install-host)
        exec node "$host_service_installer" --root "$root" "$@"
        ;;
      enable-host)
        exec node "$host_service_controller" --root "$root" enable
        ;;
      disable-host)
        exec node "$host_service_controller" --root "$root" disable
        ;;
      status-host)
        exec node "$host_service_controller" --root "$root" status
        ;;
      *)
        echo "Use: ./inspire service [install-host|enable-host|disable-host|status-host]" >&2
        exit 64
        ;;
    esac
    ;;
  -h | --help | help)
    sed -n '/^# Usage:/,/^set -euo pipefail$/ { /^#/ { s/^# //; p } }' "$0"
    ;;
  *)
    echo "Unknown mode: $mode" >&2
    echo "Use: ./inspire | ./inspire restart | ./inspire stop | ./inspire status | ./inspire mock | ./inspire dev | ./inspire build | ./inspire connection <name> [action] | ./inspire service [install-host|enable-host|disable-host|status-host]" >&2
    exit 1
    ;;
esac
