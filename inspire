#!/usr/bin/env bash
# One-command local host for insπre.
# Usage:
#   ./inspire          production host (build if needed, open browser)
#   ./inspire mock     mock host for UI-only acceptance
#   ./inspire dev      Vite + host with hot reload
#   ./inspire build    build only
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$root"

mode="${1:-start}"

need_node() {
  if ! command -v node >/dev/null 2>&1; then
    echo "Node.js is required (22.19+)." >&2
    exit 1
  fi
}

# Portable SHA-256 of stdin; falls back across common tools.
hash_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | cut -d' ' -f1
  else
    cksum | cut -d' ' -f1
  fi
}

deps_hash() {
  hash_stdin < package-lock.json 2>/dev/null || true
}

# A fingerprint of every input that affects the built client, so a pulled
# source or config change forces a rebuild instead of running an old bundle.
source_hash() {
  {
    find src shared public index.html vite.config.ts tsconfig.json tsconfig.web.json tsconfig.server.json package-lock.json \
      -type f 2>/dev/null | sort | while IFS= read -r file; do
      printf '%s ' "$file"
      hash_stdin < "$file" 2>/dev/null || true
    done
  } | hash_stdin
}

ensure_deps() {
  local want stamp="node_modules/.inspire-deps"
  want="$(deps_hash)"
  if [[ ! -d node_modules || "$(cat "$stamp" 2>/dev/null || true)" != "$want" ]]; then
    echo "Installing dependencies…"
    npm install
    printf '%s\n' "$want" > "$stamp"
  fi
}

do_build() {
  echo "Building client…"
  npm run build
  printf '%s\n' "$(source_hash)" > dist/.inspire-build
}

ensure_build() {
  if [[ ! -f dist/index.html || "$(cat dist/.inspire-build 2>/dev/null || true)" != "$(source_hash)" ]]; then
    do_build
  fi
}

open_url() {
  local url="$1"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  elif command -v gio >/dev/null 2>&1; then
    gio open "$url" >/dev/null 2>&1 || true
  fi
}

run_host() {
  local mock="${1:-0}"
  need_node
  ensure_deps
  ensure_build

  export NODE_ENV=production
  export INSPIRE_OPEN="${INSPIRE_OPEN:-1}"
  if [[ "$mock" == "1" ]]; then
    export INSPIRE_MOCK=1
  else
    unset INSPIRE_MOCK || true
  fi

  exec npx --no-install tsx server/index.ts
}

case "$mode" in
  start | host | "")
    run_host 0
    ;;
  mock)
    run_host 1
    ;;
  dev)
    need_node
    ensure_deps
    export INSPIRE_TOKEN="${INSPIRE_TOKEN:-inspire-dev-token}"
    echo "Dev host token: $INSPIRE_TOKEN"
    echo "Open http://127.0.0.1:5173/?token=$INSPIRE_TOKEN after Vite starts."
    open_url "http://127.0.0.1:5173/?token=$INSPIRE_TOKEN"
    exec npm run dev
    ;;
  build)
    need_node
    ensure_deps
    do_build
    ;;
  -h | --help | help)
    sed -n '2,8p' "$0"
    ;;
  *)
    echo "Unknown mode: $mode" >&2
    echo "Use: ./inspire | ./inspire mock | ./inspire dev | ./inspire build" >&2
    exit 1
    ;;
esac
