{
  "name": "inspire-pi-gui",
  "version": "0.6.5",
  "description": "A cross-platform local web workbench for Pi Coding Agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XWIlluDelu/pi-inspire.git"
  },
  "homepage": "https://github.com/XWIlluDelu/pi-inspire#readme",
  "bugs": {
    "url": "https://github.com/XWIlluDelu/pi-inspire/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "local-first",
    "web-ui"
  ],
  "bin": {
    "inspire": "inspire.mjs"
  },
  "files": [
    "build/",
    "CHANGELOG.md",
    "connections/",
    "deploy/",
    "dist/",
    "docs/screenshots/command-palette-dark.png",
    "docs/screenshots/conversation-dark.png",
    "docs/screenshots/conversation-light.png",
    "docs/screenshots/conversation-hydrangea-light.png",
    "docs/screenshots/mobile-chimonanthus-light.png",
    "docs/screenshots/resources-dark.png",
    "docs/screenshots/settings-light.png",
    "docs/screenshots/welcome-dark.png",
    "docs/extensions.md",
    "docs/examples/native-ui.ts",
    "docs/examples/session-activity.ts",
    "extensions/inspire-session-bridge.ts",
    "docs/host.md",
    "docs/mcp.md",
    "docs/pi-commands.md",
    "docs/ssh-reverse.md",
    "docs/tool-presentations.md",
    "inspire",
    "inspire.mjs",
    "LICENSE",
    "README.md",
    "src/assets/licenses/"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "knip": {
    "entry": [
      "server/index.ts",
      "server/terminal-daemon-entry.ts",
      "server/terminal-control-entry.ts",
      "server/session-recovery-entry.ts",
      "server/herdr-worker-entry.ts",
      "server/restart-preflight.ts",
      "server/session-search-worker.ts",
      "server/model-metadata-worker.ts",
      "deploy/systemd/control.mjs",
      "deploy/systemd/idle-maintenance-restart.mjs",
      "deploy/systemd/install.mjs",
      "scripts/import-ibm-plex-sans-sc.mjs",
      "scripts/start-browser-test-host.mjs",
      "scripts/benchmark-rich-text.mjs",
      "tests/fixtures/rich-text-benchmark.tsx",
      "public/service-worker.js",
      "tests/**/*.{test,spec}.{ts,tsx}",
      "tests/browser/fixtures/file-previews/interactive.js",
      "tests/browser/fixtures/terminal-theme.ts",
      "tests/fixtures/pi-operation-lifecycle-extension.ts",
      "tests/fixtures/pi-resource-reload-extension.ts",
      "tests/fixtures/pi-session-shutdown-extension.ts",
      "tests/fixtures/pi-child-calls-extension.ts",
      "tests/fixtures/host-control-faults.mjs",
      "tests/fixtures/pi-model-catalog-extension.ts",
      "tests/fixtures/pi-model-workflow-extension.ts",
      "tests/fixtures/pi-provider-auth-extension.ts",
      "docs/examples/native-ui.ts",
      "docs/examples/session-activity.ts",
      "extensions/inspire-session-bridge.ts",
      "docs/examples/task-board/extension.ts",
      "docs/examples/task-board/TaskBoard.tsx",
      "docs/examples/task-board/types.ts",
      "src/components/ExtensionDialogContent.tsx"
    ],
    "ignoreDependencies": [
      "@earendil-works/pi-ai"
    ],
    "ignore": [
      "server/instance-state.d.mts",
      "server/instance-control.d.mts",
      "server/proper-lockfile.d.ts",
      "server/file-lock.d.mts",
      "server/platform-paths.d.mts",
      "server/platform-environment.d.mts",
      "server/process-tree.d.mts",
      "server/launcher-restart.d.mts",
      "server/static-asset-cache.d.mts",
      "server/user-environment.d.mts",
      "tests/fixtures/tool-result-resources.d.mts"
    ]
  },
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:servers": "concurrently -k -n host,web -c cyan,magenta \"npm:dev:host\" \"npm:dev:web\"",
    "dev:host": "node scripts/start-dev-host.mjs",
    "dev:web": "vite",
    "build:web": "node scripts/build-web.mjs",
    "icons:build": "node scripts/render-app-icons.mjs",
    "build": "npm run typecheck && npm run build:web",
    "release:build": "npm run typecheck && npm run build:web -- --clean && node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-release-package.mjs",
    "prepack": "npm run release:build",
    "start": "node inspire.mjs",
    "start:mock": "node inspire.mjs mock",
    "inspire": "node inspire.mjs",
    "test": "vitest run --exclude tests/launcher.test.ts",
    "test:launcher": "vitest run tests/launcher.test.ts --maxWorkers=1",
    "test:platform": "vitest run tests/server/dev-launcher.integration.test.ts tests/server/instance-control.test.ts tests/server/app-events.test.ts tests/server/terminal attachment-retention tests/server/attachment-file-names.test.ts tests/server/host-shutdown.integration.test.ts tests/server/configuration-edit-locks.test.ts tests/server/filesystem-containment tests/server/html-preview.test.ts tests/server/pi-installation.test.ts tests/server/paths.test.ts tests/server/process-identity.test.ts tests/server/pi-session- tests/server/runtime-external-occupancy.test.ts tests/web/readonly-session.test.tsx tests/web/session-activity.test.tsx tests/server/isolated-environment.test.ts tests/server/git-inspection.test.ts tests/server/git-configuration.test.ts tests/server/resources.test.ts tests/server/resources-windows-paths.test.ts tests/server/resource-reference-identity.test.ts tests/server/app-resources.test.ts tests/web/resources.test.ts tests/web/terminal-keyboard.test.ts tests/web/terminal-settings.test.ts tests/web/terminal-settings-dialog.test.tsx tests/web/terminal-pane.test.tsx tests/web/composer-keyboard.test.ts tests/web/composer-controls.test.tsx tests/web/composer-suggestions.test.tsx tests/web/modal-focus.test.tsx tests/server/pi-prompt-lifecycle.integration.test.ts tests/server/runtime-worker-lifecycle.test.ts tests/server/runtime-persistence-ownership.test.ts tests/web/overlay-and-palette.test.tsx tests/web/text-preview-encoding.test.ts tests/web/workbench-keyboard.test.ts tests/web/workbench-shortcuts.test.tsx tests/web/command-help.test.tsx",
    "test:watch": "vitest",
    "format": "npx biome format --write",
    "format:check": "biome format",
    "lint": "biome lint --error-on-warnings && node scripts/check-import-boundaries.mjs",
    "check:unused": "knip",
    "typecheck": "tsc -b",
    "test:browser": "playwright test",
    "size:report": "npm run release:build && node scripts/size-report.mjs",
    "benchmark:projection": "node --import tsx scripts/benchmark-projection-reads.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:unused && npm run build:web && npm run test:portable && npm test && npm run test:launcher",
    "ci": "npm run check && npm run test:browser",
    "test:browser:chromium": "playwright test --project=chromium",
    "test:portable": "node --test tests/portable/*.test.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "express": "^5.2.1",
    "multer": "^2.5.0",
    "proper-lockfile": "^4.1.2",
    "strip-json-comments": "^5.0.3",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "2.5.8",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@playwright/test": "1.62.1",
    "@tanstack/react-virtual": "^3.14.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/hast": "^3.0.5",
    "@types/mdast": "4.0.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axe-core": "^4.12.1",
    "concurrently": "^9.2.4",
    "decode-named-character-reference": "1.3.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "katex": "^0.16.47",
    "knip": "^5.85.0",
    "lucide-react": "^1.25.0",
    "micromark-util-decode-string": "2.0.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math-extended": "6.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "unified": "11.0.5",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
