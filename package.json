{
  "name": "inspire-pi-gui",
  "version": "0.2.0",
  "description": "A Linux-first local web workbench for Pi Coding Agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XWIlluDelu/pi-inspire.git"
  },
  "homepage": "https://github.com/XWIlluDelu/pi-inspire#readme",
  "bugs": {
    "url": "https://github.com/XWIlluDelu/pi-inspire/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "local-first",
    "web-ui"
  ],
  "bin": {
    "inspire": "inspire"
  },
  "files": [
    "build/",
    "connections/",
    "deploy/",
    "dist/",
    "docs/screenshots/command-palette-dark.png",
    "docs/screenshots/conversation-dark.png",
    "docs/screenshots/conversation-light.png",
    "docs/screenshots/conversation-jade-light.png",
    "docs/screenshots/mobile-amber-light.png",
    "docs/screenshots/resources-dark.png",
    "docs/screenshots/settings-light.png",
    "docs/screenshots/welcome-dark.png",
    "docs/ssh-reverse.md",
    "docs/tool-presentations.md",
    "inspire",
    "LICENSE",
    "README.md",
    "src/assets/licenses/"
  ],
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "knip": {
    "entry": [
      "deploy/systemd/*.mjs",
      "scripts/*.mjs",
      "public/service-worker.js",
      "docs/redesign/prototype/app.js",
      "tests/**/*.{test,spec}.{ts,tsx}",
      "tests/benchmarks/*.ts"
    ],
    "ignore": [
      "server/instance-state.d.mts"
    ]
  },
  "scripts": {
    "dev": "concurrently -k -n host,web -c cyan,magenta \"npm:dev:host\" \"npm:dev:web\"",
    "dev:host": "INSPIRE_TOKEN=inspire-dev-token tsx watch server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build && node scripts/write-build-stamp.mjs",
    "build": "npm run typecheck && npm run build:web",
    "release:build": "npm run build && node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-release-package.mjs",
    "prepack": "npm run release:build",
    "start": "./inspire",
    "start:mock": "./inspire mock",
    "inspire": "./inspire",
    "test": "vitest run --exclude tests/launcher.test.ts",
    "test:launcher": "vitest run tests/launcher.test.ts --maxWorkers=1",
    "test:watch": "vitest",
    "format": "npx biome format --write",
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/check-lint.mjs",
    "check:unused": "knip",
    "typecheck": "tsc -b",
    "test:browser": "playwright test",
    "size:report": "npm run release:build && node scripts/size-report.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:unused && npm run build:web && npm test && npm run test:launcher",
    "ci": "npm run check && npm run test:browser"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "2.5.8",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@playwright/test": "1.62.1",
    "@tanstack/react-virtual": "^3.14.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/mdast": "4.0.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.12.1",
    "concurrently": "^9.2.4",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "katex": "^0.16.47",
    "knip": "^5.85.0",
    "lucide-react": "^1.25.0",
    "micromark-util-decode-string": "2.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math-extended": "6.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "unified": "11.0.5",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
