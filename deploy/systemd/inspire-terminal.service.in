[Unit]
Description=INSΠRE persistent terminal service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WorkingDirectory=@ROOT@
# Bootstrap Node only; the launcher obtains the user's current shell environment.
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
Environment=INSPIRE_ENVIRONMENT=shell
ExecStart=@LAUNCHER@ terminal-daemon --root @ROOT@ --host 127.0.0.1 --port 4587
Restart=on-failure
RestartSec=3
TimeoutStartSec=5min
TimeoutStopSec=15

[Install]
WantedBy=default.target
